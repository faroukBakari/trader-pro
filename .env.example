# Environment Variables Configuration
# Copy this file to .env and modify values as needed
# The .env file is the Single Source of Truth (SSOT) for non-secret configuration
#
# SECRETS: Do not put secrets (API keys, client secrets, tokens) here.
# Use .env.local.template + 1Password instead:
#   1. Add op:// ref to .env.local.template
#   2. Run: op inject -i .env.local.template -o .env.local
# See .env.local.template for details.

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
TRADER_API_BASE_PATH=
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Google OAuth (client ID is public — embedded in frontend JS bundle)
# Get from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# PostgreSQL Datastore Configuration
# These values are loaded by both Python (pydantic-settings) and docker-compose
# Option 1: Full DSN (takes precedence if set)
# DATASTORE_POSTGRES_DSN=postgresql://trader:trader_dev@localhost:5433/trader_pro

# Option 2: Individual variables (recommended for docker-compose compatibility)
DATASTORE_POSTGRES_USER=trader
DATASTORE_POSTGRES_PASSWORD=trader_dev
DATASTORE_POSTGRES_HOST=localhost
DATASTORE_POSTGRES_PORT=5433
DATASTORE_POSTGRES_DB=trader_pro