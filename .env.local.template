# trader-pro secrets — resolved by 1Password CLI
# DO NOT edit .env.local directly. Edit this template instead.
#
# Usage:
#   op inject -i .env.local.template -o .env.local
#
# Adding a new secret:
#   1. Create item in 1Password (Personal vault)
#   2. Add a secret reference below (vault/item/field pattern)
#   3. Re-run: op inject -i .env.local.template -o .env.local
#
# The .env.local file is gitignored and loaded by Vite (frontend)
# and pydantic-settings (backend) automatically.

# -- Google OAuth ---------------------------------------------------------
# OAuth 2.0 Web Client credentials from Google Cloud Console
# 1Password item: "TraderPro-GoogleOAuth" in Personal vault
GOOGLE_CLIENT_ID={{ op://Personal/TraderPro-GoogleOAuth/client_id }}
GOOGLE_CLIENT_SECRET={{ op://Personal/TraderPro-GoogleOAuth/client_secret }}
VITE_GOOGLE_CLIENT_ID={{ op://Personal/TraderPro-GoogleOAuth/client_id }}
